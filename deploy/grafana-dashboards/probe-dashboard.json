{
  "title": "PacketProber Dashboard",
  "uid": "packetprober",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 0,
  "refresh": "10s",
  "tags": ["retina", "packetprober", "monitoring"],
  "editable": true,
  "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Active Probes",
        "targets": [
          {
            "expr": "count(networkobservability_probe_total)",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Loss % by Target",
        "targets": [
          {
            "expr": "100 * (sum(rate(networkobservability_probe_failure_total[1m])) by (probe_name, endpoint, protocol) / sum(rate(networkobservability_probe_total[1m])) by (probe_name, endpoint, protocol))",
            "legendFormat": "{{probe_name}} ({{protocol}})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "decimals": 1,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 4
        }
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Latency by Target (milliseconds)",
        "targets": [
          {
            "expr": "networkobservability_probe_latency_milliseconds",
            "legendFormat": "{{probe_name}} ({{protocol}})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "decimals": 2,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 14
        }
      },
      {
        "id": 5,
        "type": "piechart",
        "title": "Failures by Error Type",
        "targets": [
          {
            "expr": "sum by (error_type) (increase(networkobservability_probe_failure_total[1h]))",
            "legendFormat": "{{error_type}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 0,
          "y": 24
        }
      },
      {
        "id": 6,
        "type": "table",
        "title": "Active Probe List",
        "targets": [
          {
            "expr": "last_over_time(networkobservability_probe_total[5m])",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "Value": true,
                "__name__": true,
                "job": true
              },
              "indexByName": {
                "probe_name": 0,
                "endpoint": 1,
                "protocol": 2,
                "node": 3,
                "pod": 4,
                "instance": 5
              },
              "renameByName": {
                "probe_name": "Probe Name",
                "endpoint": "Endpoint",
                "protocol": "Protocol",
                "node": "Source Node",
                "pod": "Source Pod",
                "instance": "Source IP"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          }
        },
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "options": {
          "showHeader": true,
          "footer": {
            "show": false
          }
        },
        "pluginVersion": "10.2.0"
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    }
}
